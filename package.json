{
  "name": "getbathtime",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "trip:theme": "node scripts/trip_theme_agent.mjs",
    "trip:content": "node scripts/trip_content_agent.mjs",
    "trip:image": "node scripts/trip_image_agent.mjs --input-dir output",
    "screenshots:ui": "node scripts/capture_ui_screenshots.mjs",
    "export:web": "expo export --platform web && node scripts/generate_static_archive_content_pages.mjs",
    "catalog:research": "node scripts/catalog_research_agent.mjs",
    "catalog:collect:browser": "node scripts/catalog_browser_collector.mjs",
    "catalog:proposal": "node scripts/catalog_normalize_agent.mjs",
    "catalog:seed:export": "node scripts/export_catalog_research_seed.mjs",
    "catalog:seed:export:postgres": "node scripts/export_catalog_research_seed_postgres.mjs",
    "content:seed:export:postgres": "node scripts/export_content_seed_postgres.mjs",
    "onsen:hokkaido:mvp:export": "node scripts/export_hokkaido_onsen_mvp_seed.mjs",
    "onsen:seed:izu-tohoku": "node scripts/build_izu_shizuoka_tohoku_reconciliation_seed.mjs",
    "onsen:verdict:check": "node scripts/check_onsen_verdict_quality.mjs",
    "onsen:card-summary": "node scripts/build_onsen_card_summary_pipeline.mjs",
    "onsen:facility-card-summary:audit": "node scripts/build_onsen_facility_card_summary_audit.mjs",
    "archive:spot:upsert": "node scripts/upsert_archive_content_from_spot_seed.mjs",
    "archive:item:upsert": "node scripts/upsert_archive_content_from_spot_seed.mjs",
    "content:api:smoke": "node scripts/smoke_content_snapshot_api.mjs",
    "admin:dev": "npm --prefix apps/admin run dev",
    "admin:build": "npm --prefix apps/admin run build",
    "public-web:dev": "npm --prefix apps/web run dev",
    "public-web:build": "npm --prefix apps/web run build",
    "public-web:typecheck": "npm --prefix apps/web run typecheck",
    "store:screenshots": "node scripts/capture_store_source_screenshots.mjs",
    "store:feature-graphic": "node scripts/generate_store_feature_graphic.mjs",
    "store:listing-screenshots": "node scripts/generate_store_listing_screenshots.mjs",
    "store:splash": "node scripts/generate_splash_icon.mjs",
    "catalog:api:mock": "node scripts/mock_catalog_api.mjs",
    "content:api:mock": "node scripts/mock_content_api.mjs",
    "security:audit": "npm audit --audit-level=high && npm --prefix apps/web audit --audit-level=high && npm --prefix apps/admin audit --audit-level=high",
    "test": "jest",
    "test:scenario:print": "jest src/engine/__tests__/scenario_output.test.ts --runInBand",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "^5.0.1",
    "@react-native-firebase/analytics": "^24.1.1",
    "@react-native-firebase/app": "^24.1.1",
    "@react-navigation/native": "^7.1.8",
    "@supabase/supabase-js": "^2.110.7",
    "expo": "~54.0.35",
    "expo-asset": "~12.0.13",
    "expo-audio": "~1.1.1",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-navigation-bar": "~5.0.10",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.11",
    "lottie-react-native": "~7.3.1",
    "phosphor-react-native": "^3.0.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.86.0",
    "react-native-reanimated": "~4.5.2",
    "react-native-safe-area-context": "~5.8.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "^15.15.5",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.11.1"
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.0",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.17",
    "playwright": "^1.59.1",
    "react-native-svg-transformer": "^1.5.3",
    "react-test-renderer": "19.1.0",
    "ts-jest": "^29.4.6",
    "typescript": "~5.9.2"
  },
  "private": true
}
