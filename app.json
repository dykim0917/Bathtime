{
  "expo": {
    "name": "바스타임",
    "slug": "getbathtime",
    "version": "1.0.0",
    "icon": "./assets/images/icon.png",
    "scheme": "getbathtime",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.getbathtime.app"
    },
    "android": {
      "package": "com.bathtimestudio.bathtime",
      "versionCode": 18,
      "googleServicesFile": "./app/google-services.json",
      "icon": "./assets/images/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-foreground.png",
        "backgroundColor": "#FFFFFF"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-notifications",
      [
        "expo-navigation-bar",
        {
          "backgroundColor": "#07191B",
          "barStyle": "light",
          "borderColor": "#183236",
          "position": "relative"
        }
      ],
      "expo-asset",
      "expo-font",
      "expo-web-browser",
      "./plugins/withAndroidReleaseOptimization",
      "./plugins/withAndroidStoreAudioManifest",
      "@react-native-firebase/app",
      "@react-native-firebase/analytics"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "aad216ef-4f0f-46d4-884e-f4f5ab5c4b64"
      }
    }
  }
}
